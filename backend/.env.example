# Required for veterinary record extraction and grounded AI features.
OPENAI_API_KEY=replace-with-your-development-key

# OpenAI model used for all structured-output calls (extraction, Ask,
# Vet Visit Prep, Smart Care Plan). Configurable so a deprecated/renamed
# model doesn't require a code change + redeploy.
OPENAI_MODEL=gpt-4o

# Per-call timeout (seconds) and bounded retry count for OpenAI requests.
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Caps a single structured response's length (cost control).
OPENAI_MAX_OUTPUT_TOKENS=2000

# Caps the combined length of all `sources[].text` in a single request.
# Per-field length is already bounded (10,000 chars each, up to 200
# sources); this bounds the aggregate so one request can't legally carry
# an outsized, expensive context.
OPENAI_MAX_TOTAL_SOURCE_CHARS=30000

# "auto" | "low" | "high" — vision/document detail level sent to OpenAI for
# document extraction. "high" is the most expensive tier; "auto" lets the
# model choose based on the image.
OPENAI_IMAGE_DETAIL=auto

# Set to "production" in your deployment platform to disable the
# auto-generated /docs, /redoc, and /openapi.json endpoints. Any other
# value (including unset) keeps them enabled for local development.
ENVIRONMENT=development

# Copy these values from the same Supabase project used by the mobile app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Comma-separated browser origins. Native Expo requests are not restricted by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Per-process development safeguards. Use a shared production rate-limit store
# when deploying multiple API instances.
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100
MAX_UPLOAD_SIZE_MB=10

# Server-only key used for user-requested account deletion. Never expose this
# value through EXPO_PUBLIC_* variables or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Transactional invitation email. Verify the sender/domain with Resend first.
RESEND_API_KEY=replace-with-resend-api-key
PAWSO_INVITE_FROM_EMAIL=Pawso <invites@your-domain.example>

# Deep link and store/beta download destinations used in invitation emails.
PAWSO_INVITE_BASE_URL=pawso://invite
PAWSO_IOS_DOWNLOAD_URL=
PAWSO_ANDROID_DOWNLOAD_URL=

# Dedicated invitation-email abuse limits per authenticated owner.
INVITATION_EMAILS_PER_MINUTE=3
INVITATION_EMAILS_PER_DAY=25
