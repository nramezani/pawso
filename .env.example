# Mobile app configuration. Copy to .env.local for local development.
# Configure the same EXPO_PUBLIC_* values in each EAS environment used to build.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
EXPO_PUBLIC_API_URL=https://your-pawso-api.example.com

# Add reviewed, published URLs before a public beta.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_OF_USE_URL=
